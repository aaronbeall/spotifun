# Last.fm API key (Required)
# Spotifun reads listening data (scrobbles, top lists, loved tracks) and artist tags from Last.fm.
# Get a key at: https://www.last.fm/api/account/create
# When deploying to Vercel, set this in the project's environment variables too.
LASTFM_API_KEY=your_lastfm_api_key_here

# Last.fm shared secret (Required for "Sign in with Last.fm")
# Shown next to the API key on https://www.last.fm/api/accounts. Without it, the sign-in button
# says sign-in isn't switched on, and people can still type a username.
# In your Last.fm API account, set the callback URL to https://<your-domain>/api/auth/lastfm/callback
LASTFM_SHARED_SECRET=your_lastfm_shared_secret_here

# Artwork, song lengths, release dates and popularity come from Deezer's public API,
# which needs no key.

# Optional: point the API clients somewhere else (a local mock server for offline development)
# LASTFM_API_BASE=http://127.0.0.1:4010/2.0/
# LASTFM_AUTH_URL=http://127.0.0.1:4010/api/auth/
# DEEZER_API_BASE=http://127.0.0.1:4010
