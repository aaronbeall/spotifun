# Spotify API Configuration (Required)
# Get your credentials at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# Important: Spotify no longer allows localhost - use 127.0.0.1
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback/spotify

# Next Auth Configuration (Required)
# Use 127.0.0.1 to match Spotify redirect URI requirements
NEXTAUTH_URL=http://127.0.0.1:3000
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Last.fm API Configuration (Optional)
# Used to supplement artist genres with Last.fm tags for better classification coverage
# Get your API key at: https://www.last.fm/api/account/create
# Note: When deploying to Vercel, also set this in your Vercel project settings
LASTFM_API_KEY=your_lastfm_api_key_here
